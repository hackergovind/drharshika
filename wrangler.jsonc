{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drharshika",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "routes": [
    { "pattern": "drharshika.in/*", "zone_name": "drharshika.in" },
    { "pattern": "www.drharshika.in/*", "zone_name": "drharshika.in" }
  ],
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  }
}
