# Neon Database URL (replace with your actual Neon DB connection string)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/drharshika?sslmode=require"

# WhatsApp number (replace with Dr. Harshika's number)
# Read by src/lib/contact.ts. Until this is set to the real number, WhatsApp
# links fall back to the placeholder below.
NEXT_PUBLIC_WHATSAPP_NUMBER="919999999999"

# Canonical site URL. The value that actually ships in canonicals, sitemap.xml,
# robots.txt and the JSON-LD graph lives in src/lib/site.ts (SITE_URL); this is
# kept only so the value is documented where the other env vars are.
NEXT_PUBLIC_SITE_URL="https://drharshika.in"
